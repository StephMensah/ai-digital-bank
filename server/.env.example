# ---- runtime ----
NODE_ENV=production
PORT=10000
PUBLIC_WEB_ORIGIN=https://pokzbank.org
JWT_SECRET=change-me-32-bytes-min
JWT_REFRESH_SECRET=change-me-too-32-bytes-min

# ---- database (Render supplies DATABASE_URL) ----
DATABASE_URL=postgres://user:pass@host:5432/aidigitalbank
PGSSL=require

# ---- Mambu core banking ----
MAMBU_BASE_URL=https://YOURTENANT.sandbox.mambu.com/api
MAMBU_API_KEY=
MAMBU_DEPOSIT_PRODUCT_ID=SAVINGS_GHS
MAMBU_LOAN_PRODUCT_ID=NANO_LOAN_GHS
MAMBU_BRANCH_ID=ACCRA_MAIN
MAMBU_WEBHOOK_SECRET=

# ---- provider 1: MTN MoMo (collections + disbursements) ----
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_TARGET_ENV=sandbox
MOMO_COLLECTION_SUBSCRIPTION_KEY=
MOMO_COLLECTION_USER_ID=
MOMO_COLLECTION_API_KEY=
MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=
MOMO_DISBURSEMENT_USER_ID=
MOMO_DISBURSEMENT_API_KEY=
MOMO_CALLBACK_URL=https://pokzbank.org/api/v1/webhooks/momo

# ---- provider 2: Paystack (cards + bank rails) ----
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ---- provider 3: KYC / identity (Ghana Card, liveness) ----
KYC_BASE_URL=https://api.dojah.io
KYC_APP_ID=
KYC_SECRET_KEY=

# ---- provider: Hubtel (checkout, wallet debit, send money) ----
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ID=
HUBTEL_MERCHANT_EMAIL=
HUBTEL_CALLBACK_URL=https://pokzbank.org/api/v1/webhooks/hubtel
HUBTEL_RETURN_URL=https://pokzbank.org/app.html
HUBTEL_WEBHOOK_SECRET=

# ---- provider 4: GhIPSS GIP (interbank instant pay) ----
GHIPSS_BASE_URL=
GHIPSS_CLIENT_ID=
GHIPSS_CLIENT_SECRET=
GHIPSS_INSTITUTION_CODE=
GHIPSS_CHANNEL_CODE=3
GHIPSS_WEBHOOK_SECRET=
# Override only if GhIPSS gave you different paths for your institution
# GHIPSS_PATH_TOKEN=/oauth/token
# GHIPSS_PATH_NAME_ENQUIRY=/gip/name-enquiry
# GHIPSS_PATH_TRANSFER=/gip/funds-transfer

# ---- python automations / AI algorithms service ----
PYTHON_SERVICE_URL=
PYTHON_SERVICE_TOKEN=
RISK_DECLINE_THRESHOLD=85
RISK_REVIEW_THRESHOLD=55

# ---- decision service (decision_api.py) ----
# Where the customer pages live. The decision service redirects every non-API
# request here, so only one site ever serves them.
BANKING_URL=https://pokzbank.org
